# Copy to .env and fill in. NEVER commit .env.

# --- NVIDIA build platform (free API key from build.nvidia.com) ---
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional overrides:
# NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# --- DeepSeek (get a key at https://platform.deepseek.com) ---
# Generated alongside Nemotron so each session is designed by BOTH models
# and the email shows them side by side for comparison.
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional overrides:
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_MODEL=deepseek-v4-pro

# Public URL of the feedback web app (link included in workout emails).
# On your Orange Pi LAN, e.g. http://orangepi.local:8080 or http://192.168.1.x:8080
WEB_URL=http://localhost:8080

# --- Gmail (use a 16-char App Password, NOT your real password) ---
# Generate at: https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
# Where to send (defaults to GMAIL_ADDRESS if blank):
EMAIL_TO=

# --- Behavior ---
# Deload every Nth session (counted from last deload):
DELOAD_EVERY=5
# Force a specific day for manual test runs (monday/friday). Leave blank in prod.
FORCE_DAY=
# History file path (mounted volume in Docker):
HISTORY_PATH=/data/history.json
# Container timezone so cron fires at 5am LOCAL, not UTC:
TZ=America/New_York

# --- Garmin (optional but recommended — feeds training load, sleep, stress &
# recovery into workout design) ---
# One-time interactive login with your Garmin Connect account (MFA supported):
#   python -m src.setup_garmin
# It saves OAuth tokens (valid ~1 year) to GARMIN_TOKENS_PATH; your password is
# NOT stored. Re-run setup_garmin when the tokens eventually expire.
# Optional: prefill the login email so setup only prompts for the password.
GARMIN_EMAIL=
# Token directory + activity cache DB (keep on the mounted volume in Docker):
GARMIN_TOKENS_PATH=/data/garmin_tokens
GARMIN_DB_PATH=/data/garmin.db
